<!DOCTYPE html>
<html>
<head>
<link rel="stylesheet" href="sitestyling.css">
<center><img src="forgotusername.png" alt="banner"></center>
<br>
</head>
<body>
<center><img src="emoji-thinking.gif" height=15% width=15% alt="thinkingemoji"></center>
<center><p style="color:red;">Enter your password below...</p></center>
<form id="SubmissionForm">
<div class = "userlogin_container">
<label for="Password"><b>Password</b></label>
<input type="password" name="Password" id="Password" required>
<input type="submit" value="Submit" id="submitButton">
<p id="result" style="color:rgb(248, 0, 0);"></p>
</body>
</html>

<script src="script.js"></script>
<script>
    //Gets form submission details and result id details
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('SubmissionForm');
        const resultDisplay = document.getElementById('result');
        
        //Listens for input
        form.addEventListener('submit', function (event) {
            event.preventDefault();
            
            //Gets password details to match with related username
            const password = document.getElementById('Password').value;
            
            let users = JSON.parse(localStorage.getItem('RegisteredUsers')) || { "Registered Users": [] };

            //Function for finding user details
            function findUser(usersData) {
                const user = usersData['Registered Users'].find(user => user.Password === password);
                if (user) {
                    resultDisplay.textContent = `Your username is: ${user.Username}`;
                } else {
                    resultDisplay.textContent = 'Password not found!';
                }
            }

            //Checks localstorage first
            if (users['Registered Users'].length > 0) {
                findUser(users);
            } else {
                //Checks json instead
                fetch('RegisteredUsers.json')
                    .then(response => response.json())
                    .then(responseData => findUser(responseData))
                    .catch(error => {
                        console.error('Fetch request failed:', error);
                        resultDisplay.textContent = 'Error loading users.';
                        resultDisplay.style.color = 'red';
                    });
            }
        });
    });
</script>
